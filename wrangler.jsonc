{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://iankcheruiyot.work",
    "CONTACT_TO_EMAIL": "iankcheruiyot@gmail.com",
    "CONTACT_FROM_EMAIL": "info@iankcheruiyot.work",
    "SMTP_HOST": "smtp-relay.brevo.com",
    "SMTP_PORT": "587",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADqcSVcD_4_DGAPg"
  }
}
