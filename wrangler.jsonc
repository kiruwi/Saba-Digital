{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-24",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://iankcheruiyot.work",
    "CONTACT_TO_EMAIL": "iankcheruiyot@gmail.com",
    "CONTACT_FROM_EMAIL": "Ian Cheruiyot <i@info.iankcheruiyot.work>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADqcSVcD_4_DGAPg"
  }
}
