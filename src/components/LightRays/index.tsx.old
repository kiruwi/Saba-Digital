import LightRays from './LightRays';

export default LightRays;

type Origin =
  | 'top-center'
  | 'top-left'
  | 'top-right'
  | 'left'
  | 'right'
  | 'bottom-left'
  | 'bottom-center'
  | 'bottom-right';

interface AnchorDir {
  anchor: [number, number];
  dir: [number, number];
}

// Map origin string → anchor and direction (in px)
const getAnchorAndDir = (
  origin: Origin,
  width: number,
  height: number
): AnchorDir => {
  const outside = 0.2;
  switch (origin) {
    case 'top-left':
      return { anchor: [0, -outside * height], dir: [0, 1] };
    case 'top-right':
      return { anchor: [width, -outside * height], dir: [0, 1] };
    case 'left':
      return { anchor: [-outside * width, 0.5 * height], dir: [1, 0] };
    case 'right':
      return { anchor: [(1 + outside) * width, 0.5 * height], dir: [-1, 0] };
    case 'bottom-left':
      return { anchor: [0, (1 + outside) * height], dir: [0, -1] };
    case 'bottom-center':
      return { anchor: [0.5 * width, (1 + outside) * height], dir: [0, -1] };
    case 'bottom-right':
      return { anchor: [width, (1 + outside) * height], dir: [0, -1] };
    default: // top-center
      return { anchor: [0.5 * width, -outside * height], dir: [0, 1] };
  }
};

interface LightRaysProps {
  raysOrigin?: Origin;
  raysColor?: string;
  raysSpeed?: number;
  lightSpread?: number;
  rayLength?: number;
  pulsating?: boolean;
  fadeDistance?: number;
  saturation?: number;
  followMouse?: boolean;
  mouseInfluence?: number;
  noiseAmount?: number;
  distortion?: number;
  className?: string;
}

/**
 * LightRays – a lightweight, self-contained WebGL component that renders
 * animated light-rays. The effect is intentionally minimal so it can run
 * on low-end devices.
 */
const LightRays: React.FC<LightRaysProps> = ({
  raysOrigin = 'top-center',
  raysColor = DEFAULT_COLOR,
  raysSpeed = 1,
  lightSpread = 1,
  rayLength = 2,
  pulsating = false,
  fadeDistance = 1.0,
  saturation = 1.0,
  followMouse = true,
  mouseInfluence = 0.1,
  noiseAmount = 0.0,
  distortion = 0.0,
  className = '',
}) => {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const uniformsRef = useRef<any>(null);
  const rendererRef = useRef<any>(null);
  const mouseRef = useRef({ x: 0.5, y: 0.5 });
  const smoothMouseRef = useRef({ x: 0.5, y: 0.5 });
  const animationIdRef = useRef<number | null>(null);
  const meshRef = useRef<any>(null);
  const cleanupFunctionRef = useRef<(() => void) | null>(null);
  const [isVisible, setIsVisible] = useState(false);
  const observerRef = useRef<IntersectionObserver | null>(null);

  useEffect(() => {
    if (!containerRef.current) return;
    observerRef.current = new IntersectionObserver(
      (entries) => setIsVisible(entries[0].isIntersecting),
      { threshold: 0.1 }
    );
    observerRef.current.observe(containerRef.current);
    return () => observerRef.current?.disconnect();
  }, []);

  useEffect(() => {
    if (!isVisible || !containerRef.current) return;
    cleanupFunctionRef.current?.();
    cleanupFunctionRef.current = null;

    const init = async () => {
      await new Promise((r) => setTimeout(r, 10));
      if (!containerRef.current) return;

      const renderer = new Renderer({ dpr: Math.min(window.devicePixelRatio, 2), alpha: true });
      rendererRef.current = renderer;
      const gl = renderer.gl as WebGLRenderingContext;
      // Force canvas to be highly visible with explicit styling
      gl.canvas.style.position = 'absolute';
      gl.canvas.style.top = '0';
      gl.canvas.style.left = '0';
      gl.canvas.style.width = '100%';
      gl.canvas.style.height = '100%';
      gl.canvas.style.zIndex = '5';
      gl.canvas.style.opacity = '1';
      containerRef.current.innerHTML = '';
      containerRef.current.appendChild(gl.canvas);

      const vert =
        'attribute vec2 position;varying vec2 vUv;void main(){vUv=position*0.5+0.5;gl_Position=vec4(position,0.0,1.0);}';

      // Shader for light rays - enhanced version for visibility
      const frag = `
        precision highp float;
        varying vec2 vUv;
        uniform vec2 resolution;
        uniform float time;
        uniform vec2 mouse;
        uniform vec2 rayPos;
        uniform vec2 rayDir;
        uniform vec3 rayColor;
        uniform float speed;
        uniform float spread;
        uniform float rayLength;
        uniform float fadeDistance;
        uniform float saturation;
        uniform float noiseAmount;
        uniform float distortion;
        
        // Improved noise function
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f); // Smoother interpolation
          return mix(
            mix(fract(sin(dot(i + vec2(0.0, 0.0), vec2(12.9898, 78.233))) * 43758.5453),
                fract(sin(dot(i + vec2(1.0, 0.0), vec2(12.9898, 78.233))) * 43758.5453), u.x),
            mix(fract(sin(dot(i + vec2(0.0, 1.0), vec2(12.9898, 78.233))) * 43758.5453),
                fract(sin(dot(i + vec2(1.0, 1.0), vec2(12.9898, 78.233))) * 43758.5453), u.x), u.y);
        }
        
        void main() {
          vec2 uv = vUv;
          vec2 texCoord = uv * resolution / max(resolution.x, resolution.y);
          
          // Ensure rays come from the top center
          vec2 sourcePos = rayPos;
          
          // Ray direction (normalized) with enhanced direction
          vec2 dir = normalize(rayDir);
          
          // Mouse influence - more responsive
          dir = mix(dir, normalize(mouse - vec2(0.5)), ${mouseInfluence.toFixed(4)} * 2.0);
          
          // Calculate angle to create multiple rays
          float angle = atan(dir.y, dir.x);
          
          // Create multiple rays for a more dramatic effect
          float numRays = 12.0;
          float raySpread = 3.14159 / numRays;
          
          // Start with no intensity
          float totalIntensity = 0.0;
          
          // Generate multiple rays
          for(float i = 0.0; i < numRays; i++) {
            // Offset each ray by a fraction of the spread
            float rayAngle = angle + (i - numRays/2.0) * raySpread * spread;
            vec2 rayDir = vec2(cos(rayAngle), sin(rayAngle));
            
            // Calculate ray intensity based on distance from ray origin
            float projDist = dot(texCoord - sourcePos, rayDir);
            float perpDist = length((texCoord - sourcePos) - projDist * rayDir);
            
            // Thinner rays with sharper falloff
            float perpFactor = smoothstep(0.05 * spread, 0.0, perpDist);
            
            // Make rays longer
            float distFalloff = smoothstep(rayLength * 1.5, 0.0, max(0.0, projDist));
            
            // Vary intensity based on ray index
            float rayVariation = 0.7 + 0.3 * sin(i * 1.618 + time * speed);
            
            // Add to total intensity
            totalIntensity += perpFactor * distFalloff * rayVariation;
          }
          
          // Add pulsation effect
          float pulse = ${pulsating ? 'sin(time * speed * 1.0) * 0.2 + 0.8' : '1.0'};
          totalIntensity *= pulse;
          
          // Add noise for texture
          float noiseVal = noise((texCoord + time * 0.1) * 3.0);
          totalIntensity = mix(totalIntensity, totalIntensity * (0.8 + 0.4 * noiseVal), noiseAmount);
          
          // Apply distortion
          totalIntensity = mix(totalIntensity, totalIntensity * (0.7 + 0.6 * sin(texCoord.x * 20.0 + time)), distortion * 0.3);
          
          // Amplify intensity for better visibility
          totalIntensity = pow(totalIntensity, 0.7) * 1.5 * fadeDistance;
          
          // Clamp to prevent overdraw
          totalIntensity = min(totalIntensity, 1.2);
          
          // Final color with enhanced saturation
          vec3 color = mix(vec3(totalIntensity), rayColor * totalIntensity, saturation * 1.3);
          
          // Add glow effect
          color += rayColor * totalIntensity * 0.5;
          
          gl_FragColor = vec4(color, totalIntensity * 0.9);
        }
      `;

      // Create geometry for a full-screen quad
      const geometry = new Plane(gl, { width: 2, height: 2 });
      
      // Setup shader program with all uniforms
      const program = new Program(gl, {
        vertex: vert,
        fragment: frag,
        transparent: true,
        uniforms: {
          resolution: { value: [containerRef.current.offsetWidth, containerRef.current.offsetHeight] },
          time: { value: 0 },
          mouse: { value: [0.5, 0.5] },
          rayPos: { value: [0, 0] },
          rayDir: { value: [0, 1] },
          rayColor: { value: hexToRgb(raysColor) },
          speed: { value: raysSpeed },
          spread: { value: lightSpread },
          rayLength: { value: rayLength },
          fadeDistance: { value: fadeDistance },
          saturation: { value: saturation },
          noiseAmount: { value: noiseAmount },
          distortion: { value: distortion }
        },
      });

      // Create mesh and store references
      const mesh = new Mesh(gl, { geometry, program });
      
      // Add to scene if available
      if (renderer.scene) {
        mesh.setParent(renderer.scene);
      }
      
      meshRef.current = mesh;
      uniformsRef.current = program.uniforms;

      const resize = () => {
        if (!containerRef.current) return;
        const { width, height } = containerRef.current.getBoundingClientRect();
        renderer.setSize(width, height);
        uniformsRef.current.resolution.value = [width, height];
        updatePlacement();
      };

      const updatePlacement = () => {
        if (!containerRef.current || !uniformsRef.current) return;
        const { width, height } = containerRef.current.getBoundingClientRect();
        const { anchor, dir } = getAnchorAndDir(raysOrigin, width, height);
        uniformsRef.current.rayPos.value = anchor;
        uniformsRef.current.rayDir.value = dir;
      };

      const loop = (t: number) => {
        if (!uniformsRef.current || !rendererRef.current || !meshRef.current) return;
        
        uniformsRef.current.time.value = t * 0.001;
        
        // Smooth mouse following
        if (followMouse) {
          smoothMouseRef.current.x += (mouseRef.current.x - smoothMouseRef.current.x) * 0.05;
          smoothMouseRef.current.y += (mouseRef.current.y - smoothMouseRef.current.y) * 0.05;
          uniformsRef.current.mouse.value = [
            smoothMouseRef.current.x,
            1.0 - smoothMouseRef.current.y // Flip Y coordinate for WebGL
          ];
        }
        
        try {
          // Make sure the mesh is properly initialized
          if (meshRef.current && meshRef.current.program && meshRef.current.geometry) {
            rendererRef.current.render({ scene: meshRef.current });
          }
        } catch (error) {
          console.error('Rendering error:', error);
        }
        
        animationIdRef.current = requestAnimationFrame(loop);
      };

      renderer.setSize(containerRef.current.offsetWidth, containerRef.current.offsetHeight);
      cleanupFunctionRef.current = () => {
        cancelAnimationFrame(animationIdRef.current!);
        window.removeEventListener('resize', resize);
        renderer.gl.canvas.remove();
      };

      resize();
      window.addEventListener('resize', resize);
      animationIdRef.current = requestAnimationFrame(loop);
    };

    init().catch(console.error);

    return () => {
      cleanupFunctionRef.current?.();
      cleanupFunctionRef.current = null;
    };
  }, [isVisible, raysOrigin, raysColor, raysSpeed, lightSpread, rayLength, pulsating, fadeDistance, saturation, followMouse, mouseInfluence, noiseAmount, distortion]);

  // Mouse tracking
  useEffect(() => {
    if (!followMouse) return;
    const handler = (e: MouseEvent) => {
      if (!containerRef.current) return;
      const rect = containerRef.current.getBoundingClientRect();
      mouseRef.current = {
        x: (e.clientX - rect.left) / rect.width,
        y: (e.clientY - rect.top) / rect.height,
      };
    };
    window.addEventListener('mousemove', handler);
    return () => window.removeEventListener('mousemove', handler);
  }, [followMouse]);

  return <div ref={containerRef} className={`light-rays-container pointer-events-none ${className}`.trim()} />;
};

export default LightRays;